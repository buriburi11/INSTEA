# Copy this file to .env.local and fill in values for your machine:
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the app, and every
# VITE_ value is bundled into the public JavaScript. Never put secrets
# (API keys, passwords, tokens) in a VITE_ variable; those belong in the backend.

# Display name used in the UI.
VITE_APP_NAME=INSTEA

# Base URL of the backend API (not used until the backend is connected).
VITE_API_BASE_URL=http://localhost:8080/api

# Environment label: development, staging, or production.
VITE_APP_ENV=development
